# TWRP fstab for aistb2 (skb BID-AI100 / INTEK)
# Android 9 / A-only / non-dynamic / FBE with keymaster HAL 4.0

# mount point         fstype  device                            device2                   flags

# --- Mountable ext4 partitions + raw image aliases ---
/system              ext4    /dev/block/by-name/system                                  flags=display="System";backup=1
/system_image        emmc    /dev/block/by-name/system                                  flags=display="System";backup=0;flashimg=1

/vendor              ext4    /dev/block/by-name/vendor                                  flags=display="Vendor";backup=1
/vendor_image        emmc    /dev/block/by-name/vendor                                  flags=display="Vendor";backup=0;flashimg=1

/product             ext4    /dev/block/by-name/product                                 flags=display="Product";backup=1
/product_image       emmc    /dev/block/by-name/product                                 flags=display="Product";backup=0;flashimg=1

/data                ext4    /dev/block/by-name/userdata                                flags=display="Data";backup=0;wipeingui;formattable
/cache               ext4    /dev/block/by-name/cache                                   flags=display="Cache";backup=1;wipeingui;formattable
/btv_home            ext4    /dev/block/by-name/btv_home                                flags=display="B tv home";backup=1
/vendor/factory      ext4    /dev/block/by-name/factory_setting                         flags=display="Factory";backup=1

# --- Image partitions exposed to TWRP Install Image + Backup ---
/boot                emmc    /dev/block/by-name/boot                                    flags=display="Boot";backup=1;flashimg=1
/recovery            emmc    /dev/block/by-name/recovery                                flags=display="Recovery";backup=1;flashimg=1
/dtbo                emmc    /dev/block/by-name/dtbo                                    flags=display="DTBO";backup=1;flashimg=1
/vbmeta              emmc    /dev/block/by-name/vbmeta                                  flags=display="VBMeta";backup=1;flashimg=1
/fastlogo            emmc    /dev/block/by-name/fastlogo                                flags=display="Boot Logo";backup=1;flashimg=1

# --- Risky bootloader-class partitions: backup/visibility only ---
# No flashimg here, to avoid accidental brick-risk image flashing.
/fastboot_1st        emmc    /dev/block/by-name/fastboot_1st                            flags=display="Fastboot 1";backup=1
/fastboot_2nd        emmc    /dev/block/by-name/fastboot_2nd                            flags=display="Fastboot 2";backup=1
/tzk_recovery        emmc    /dev/block/by-name/tzk_recovery                            flags=display="Recovery TZK";backup=1
/bl_recovery         emmc    /dev/block/by-name/bl_recovery                             flags=display="Recovery Bootloader";backup=1
/tzk_normal          emmc    /dev/block/by-name/tzk_normal                              flags=display="Synaptics TZK";backup=1
/bl_normal           emmc    /dev/block/by-name/bl_normal                               flags=display="Synaptics Bootloader";backup=1
/misc                emmc    /dev/block/by-name/misc                                    flags=display="Misc";backup=1

# --- USB storage ---
# /dev/block/sd[ab]1 is not stable across hot-unplug/replug; on a re-insert
# the kernel hands out sdc/sdd. /sbin/aistb2-usb-symlinks.sh polls
# /sys/block and re-points these symlinks at whichever sdX is currently
# present, grouped by USB host (xhci -> usb1, others -> usb2).
/usb-otg             auto    /dev/block/aistb2-usb1p1          /dev/block/aistb2-usb1    flags=removable;storage;display="USB 1"
/usb-otg2            auto    /dev/block/aistb2-usb2p1          /dev/block/aistb2-usb2    flags=removable;storage;display="USB 2"
